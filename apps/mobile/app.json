{
  "expo": {
    "name": "Дневник атлета",
    "slug": "fitcoach-3-development",
    "version": "3.0.0",
    "icon": "./assets/brand/icon.png",
    "splash": { "backgroundColor": "#0C171C" },
    "orientation": "portrait",
    "android": {
      "package": "com.fitcoach.v3",
      "versionCode": 34,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/background.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#0C171C"
      },
      "allowBackup": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      ["expo-image-picker", { "microphonePermission": false }],
      ["expo-notifications", { "icon": "./assets/brand/notification-icon.png", "color": "#1FC8F2" }],
      ["./plugins/withNotificationLargeIcon.cjs", { "icon": "./assets/brand/notification-large-icon.png" }],
      "@react-native-community/datetimepicker"
    ],
    "platforms": [
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "698a26af-08d4-44f4-9507-747143ad4f02"
      }
    },
    "owner": "hwankarasu"
  }
}
